# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# --- Copernicus Data Space Ecosystem (Sentinel-1 SAR product search + download) ---
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# --- Climate Data Store (ERA5 wind / wave reanalysis) ---
CDS_API_KEY=

# --- Copernicus Marine Service (ocean currents for drift prediction) ---
CMEMS_USERNAME=
CMEMS_PASSWORD=

# --- optional: override any config.yaml value, nested keys use "__" ---
# SAROIL_DETECTION__PROB_THRESHOLD=0.6
