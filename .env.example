# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# --- Copernicus Data Space Ecosystem (Sentinel-1 SAR product search + download) ---
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# --- Climate Data Store (ERA5 wind / wave reanalysis) ---
CDS_API_KEY=

# --- Copernicus Marine Service (ocean currents for drift prediction) ---
CMEMS_USERNAME=
CMEMS_PASSWORD=

# --- Postgres + PostGIS (alert registry + API data store) ---
# postgresql://user:password@host:5432/dbname
DATABASE_URL=

# --- Anthropic (Step 8.1: natural-language Q&A over attribution results) ---
ANTHROPIC_API_KEY=

# --- optional: override any config.yaml value, nested keys use "__" ---
# Comma-separated extra CORS origins for a deployed frontend (e.g. Vercel).
# SAROIL_API__CORS_ORIGINS=https://your-app.vercel.app

# --- optional: override any config.yaml value, nested keys use "__" ---
# SAROIL_DETECTION__PROB_THRESHOLD=0.6
