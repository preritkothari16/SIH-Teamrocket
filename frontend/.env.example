# Backend API base URL. Leave empty to use the Vite dev server proxy (relative /api paths)
# in local dev — that proxy only exists under `npm run dev` and is not part of a production
# build, so a deployed frontend (e.g. this repo's own Vercel deploy) has no dev-server fallback
# to fall through to and MUST set this explicitly, or every request 404s against the frontend's
# own origin instead of reaching the backend at all.
#   Local dev, direct backend (no proxy):  http://localhost:8000
#   Production (this repo's Render deploy): https://sih-teamrocket.onrender.com
VITE_API_BASE_URL=

# Set to "true" to fall back to fixture JSON files when the backend is unreachable.
# Default: false (real backend only).
VITE_USE_MOCKS=false
