# Backend API base URL. Leave empty to use the Vite dev server proxy (relative /api paths).
# Set to http://localhost:8000 for direct backend access (requires CORS on backend).
VITE_API_BASE_URL=

# Set to "true" to fall back to fixture JSON files when the backend is unreachable.
# Default: false (real backend only).
VITE_USE_MOCKS=false
