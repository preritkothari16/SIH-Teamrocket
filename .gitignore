# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# --- secrets ---
.env
.env.local
.env.*.local

# --- vercel ---
.vercel/

# --- data + model weights (keep dir structure only) ---
data/raw/*
data/processed/*
data/ais/*
data/env/*
data/alerts/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/ais/.gitkeep
!data/env/.gitkeep
!data/alerts/.gitkeep

# --- demo scene (fresh-clone out-of-the-box) ---
!data/processed/demo_pipeline/
!data/processed/demo_pipeline/**

models/*
!models/.gitkeep

# --- external raw dataset copies (tens of GB, never belongs in git) ---
/01_Train_Val_Oil_Spill_images/

# --- notebooks ---
.ipynb_checkpoints/

# --- os / editor ---
.DS_Store
.idea/
.vscode/

# --- generated rasters (mask files, tile outputs) ---
*.tif
*.tiff

# --- per-tool skill copies (npx skills add): .agents/skills/ is the real,
# committed source; every other tool's own directory (.claude/skills/,
# .codex/, etc.) is meant to be a local symlink to it, regenerated by
# re-running the installer - not duplicated into version control. Windows
# without symlink privileges materializes a full copy instead of a
# symlink, which is exactly what this avoids committing.
.claude/skills/supabase/
.claude/skills/supabase-postgres-best-practices/
